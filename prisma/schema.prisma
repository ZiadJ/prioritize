enum MeasurementType {
  None // For non-countable items
  Units // Generic unit for countable items
  Time // Hours per month
  Weight // Kilograms
  Volume // Cubic Metres
  Area // Square Metres
  Length // Metres
  Energy // Joules
}

model Feedback {
  id         Int      @id @default(autoincrement())
  modifiedAt DateTime @updatedAt
  createdAt  DateTime @default(now())
  isActive   Boolean  @default(true)

  user                User    @relation(fields: [userId], references: [id])
  userId              String
  type                Int     @default(0)
  rating              Int
  confidence          Int
  // type             Int // FeedbackType // User, Revision, RequestNode, Effect, ProposalStep
  // targetId         String
  comment             String  @default("")
  requireCommentOnNeg Boolean @default(false) // Require a comment for negative feedback unless a related rating is specified

  Revisions RevisionNode[]

  // request       Request?     @relation(fields: [requestId], references: [id], onDelete: Cascade)
  // requestId     Int?
  requestNode   RequestNode? @relation(fields: [requestNodeId], references: [id], onDelete: Cascade)
  requestNodeId Int?
  proposal      Proposal?    @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  proposalId    Int?
  effect        Effect?      @relation(fields: [effectId], references: [id], onDelete: Cascade)
  effectId      Int?
  // @@index([requestId])

  @@unique([userId, requestNodeId, proposalId])
  @@unique([userId, effectId])
}

model Token {
  id           Int      @id @default(autoincrement())
  accessToken  String   @unique
  refreshToken String   @unique
  createdAt    DateTime @default(now())
  expiresAt    DateTime // Fecha de expiración del token

  user   User   @relation(fields: [userId], references: [id])
  userId String
}

model User {
  id        String   @id @default(cuid())
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  isActive  Boolean  @default(true)

  firstname     String    @default("")
  lastname      String    @default("")
  username      String    @unique
  email         String    @unique
  password      String
  bio           String    @default("")
  picture       String?
  githubId      String?   @unique
  tokenVersion  Int       @default(0)
  lastTimeVisit DateTime?
  dateOfBirth   DateTime?
  longitude     Int       @default(0) // For delivery cost estimation
  lattitude     Int       @default(0)
  preferences   Json      @default("{}") // Json(no Sqlite support)
  isVerified    Boolean   @default(false)
  role          String    @default("")

  pointsReceived  Int @default(0) // The total points received over time
  pointsAvailable Int @default(0) // The available points spendable on a user request

  community   Community? @relation(fields: [communityId], references: [id])
  communityId Int?
  country     Country?   @relation(fields: [countryId], references: [id])
  countryId   Int?

  expertise         ExpertiseNode[]
  assginedSteps     Step[]
  feedback          Feedback[]
  comments          Comment[]
  revisions         RevisionNode[]
  tags              Tag[]
  fromRelationships UserRelation[]  @relation("from")
  toRelationships   UserRelation[]  @relation("to")

  editableRequests     Request[]     @relation("requestEditors")
  ownedRequests        Request[]     @relation("RequestOwner")
  editableRequestNodes RequestNode[] @relation("RequestNodeEditors")
  ownedRequestNodes    RequestNode[] @relation("RequestNodeOwner")
  editableProposals    Proposal[]    @relation("ProposalEditors")
  ownedProposals       Proposal[]    @relation("ProposalOwner")
  editableSteps        Step[]        @relation("StepEditors")
  ownedSteps           Step[]        @relation("StepOwner")
  editableStepCosts    StepCost[]    @relation("StepCostEditors")
  ownedStepCosts       StepCost[]    @relation("StepCostOwner")
  editableResources    Resource[]    @relation("ResourceEditors")
  ownedResources       Resource[]    @relation("ResourceOwner")

  userRequests   UserRequest[]
  tokens         Token[]
  stockMovements StockMovement[]

  @@index([username])
}

model UserRelation {
  id         Int      @id @default(autoincrement())
  modifiedAt DateTime @updatedAt
  createdAt  DateTime @default(now())
  isActive   Boolean  @default(true)

  type String @default("friend")

  from   User   @relation("from", fields: [fromId], references: [id])
  fromId String
  to     User   @relation("to", fields: [toId], references: [id])
  toId   String
}

// Revision information that are applied to the targeted row 
// and column after approval

model RevisionNode {
  id         Int      @id @default(autoincrement())
  modifiedAt DateTime @updatedAt
  createdAt  DateTime @default(now())
  isActive   Boolean  @default(true)

  title       String // @unique
  description String
  isDirty     Boolean? // Client-server-clients sync flag
  // revisions   Revision[] 

  path     String         @unique
  depth    Int            @default(0)
  numchild Int            @default(0)
  parent   RevisionNode?  @relation("Self", fields: [parentId], references: [id], onDelete: Cascade)
  parentId Int?
  children RevisionNode[] @relation("Self")

  data          String // Json(no Sqlite support)
  type          Int // RevisionType // Self, Suggestion, Deduplication, ModeratorFlag
  isApproved    Boolean // Based on feedback ratings but is not required for self revisions
  approvedAt    DateTime
  isLastApplied Boolean // Is the last applied version
  isRejected    Boolean // Based on feedback ratings
  rejectedAt    DateTime

  feedback Feedback[]

  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String
  request         Request?       @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId       Int?
  RequestNode     RequestNode?   @relation(fields: [requestNodeId], references: [id], onDelete: Cascade)
  requestNodeId   Int?
  proposal        Proposal?      @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  proposalId      Int?
  Step            Step?          @relation(fields: [stepId], references: [id], onDelete: Cascade)
  stepId          Int?
  stepCost        StepCost?      @relation(fields: [stepCostId], references: [id], onDelete: Cascade)
  stepCostId      Int?
  effect          Effect?        @relation(fields: [effectId], references: [id], onDelete: Cascade)
  effectId        Int?
  expertiseNode   ExpertiseNode? @relation(fields: [expertiseNodeId], references: [id], onDelete: Cascade)
  expertiseNodeId Int?
  resource        Resource?      @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  resourceId      Int?
  effectHook      Effector?      @relation(fields: [effectHookId], references: [id], onDelete: Cascade)
  effectHookId    Int?
  comment         Comment?       @relation(fields: [commentId], references: [id])
  commentId       Int?

  //@@unique([userId, requestId, requestId, requestNodeId, proposalId, proposalId, stepId, stepCostId, effectId, expertiseNodeId, resourceId, effectHookId])
  @@index([path])
}

model CognitiveBias {
  id         Int      @id @default(autoincrement())
  modifiedAt DateTime @updatedAt
  createdAt  DateTime @default(now())
  isActive   Boolean  @default(true)

  title            String  @unique
  description      String
  isLogicalFallacy Boolean
  courseUrl        String

  AssignedCognitiveBias AssignedCognitiveBias[]
}

model AssignedCognitiveBias {
  id         Int      @id @default(autoincrement())
  modifiedAt DateTime @updatedAt
  createdAt  DateTime @default(now())
  isActive   Boolean  @default(true)

  title       String  @unique
  description String
  isResolved  Boolean

  cognitiveBias   CognitiveBias @relation(fields: [cognitiveBiasId], references: [id], onDelete: Cascade)
  cognitiveBiasId Int
  proposal        Proposal      @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  proposalId      Int
  requestNode     RequestNode   @relation(fields: [requestNodeId], references: [id], onDelete: Cascade)
  requestNodeId   Int
}

model Tag {
  id   Int    @id @default(autoincrement())
  name String @unique
  // type String @default("request")

  users       User[]
  request     Request[]
  requestNode RequestNode[]
  proposal    Proposal[]
  step        Step[]
  stepCost    StepCost[]
  effect      Effect[]
  resource    Resource[]

  // @@unique([name, type])
  @@index([name])
}

// A composable expertise allowing one to make attributions 
// to specific user requestNodes

model ExpertiseNode {
  id         Int      @id @default(autoincrement())
  modifiedAt DateTime @updatedAt
  createdAt  DateTime @default(now())
  isActive   Boolean  @default(true)

  title       String         @unique
  description String         @default("")
  isDirty     Boolean? // Client->server->clients sync flag
  revisions   RevisionNode[]

  path     String          @unique
  depth    Int             @default(0)
  numchild Int             @default(0)
  parent   ExpertiseNode?  @relation("Self", fields: [parentId], references: [id], onDelete: Cascade)
  parentId Int?
  children ExpertiseNode[] @relation("Self")

  users        User[]
  effects      Effect[]
  requestNodes RequestNode[]

  @@index([path])
}

model Request {
  id         Int      @id @default(autoincrement())
  modifiedAt DateTime @updatedAt
  createdAt  DateTime @default(now())
  isActive   Boolean  @default(true)

  title       String
  description String
  isDirty     Boolean? // Client-server-clients sync flag
  revisions   RevisionNode[]

  // Variant hierarchy for similar requests with different parameters
  path     String    @default("")
  depth    Int       @default(0)
  numchild Int       @default(0)
  parent   Request?  @relation("Self", fields: [parentId], references: [id], onDelete: Cascade)
  parentId Int?
  children Request[] @relation("Self")

  community   Community? @relation(fields: [communityId], references: [id])
  communityId Int?
  country     Country?   @relation(fields: [countryId], references: [id])
  countryId   Int?
  owner       User       @relation("RequestOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId     String

  isApproved      Boolean         @default(false)
  isPrivate       Boolean         @default(false)
  isJoinable      Boolean         @default(false) // Whether other users can join this request as a shared request without specifying their own quantity
  measurementType MeasurementType

  requestNodes RequestNode[]
  tags         Tag[]
  effects      Effect[]
  userRequests UserRequest[]
  proposals    Proposal[] // Auto-generated when adding proposed steps

  editors User[] @relation("requestEditors")

  // Denormalized aggregates
  totalQuantity    Float @default(0)
  totalPriority    Float @default(0)
  userRequestCount Int   @default(0)

  @@index([path])
  @@index([communityId])
  @@index([totalPriority])
}

// Tracks the quantity of a good or service requested by a user as part of a request
model UserRequest {
  id         Int      @id @default(autoincrement())
  modifiedAt DateTime @updatedAt
  createdAt  DateTime @default(now())
  isActive   Boolean  @default(true)

  request   Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId Int
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  quantity    Float   @default(0) // Defaults to 0 for shared/joined requests with no measurable quantity
  priority    Int // Tokens the user is willing to spend on the request. Tokens are allocated monthly and are eliminated upon delivery.
  isBasicNeed Boolean @default(false)
  isJoined    Boolean @default(false) // Whether the user joined the request as a shared request rather than specifying their own quantity
  // isPrivate   Boolean @default(false)

  recurrencePeriod    Int // In days even thoughDaily, Weekly, Monthly, Quaterly, Semi-anually, Anually
  dueAt               DateTime? // The user request deadline
  deliveredAt         DateTime? // Is reset based on the recurrence period using a cron job
  estimatedDeliveryAt DateTime?
  missedDeliveryAt    DateTime? // For tracking missed deliveries and adjusting the next delivery date accordingly
  comment             String    @default("")

  @@unique([requestId, userId])
  @@index([requestId])
  @@index([userId])
}

// Used for calculating recyclability (and eventually determine side-effects)
model RequestNode {
  id         Int      @id @default(autoincrement())
  modifiedAt DateTime @updatedAt
  createdAt  DateTime @default(now())
  isActive   Boolean  @default(true)

  title       String
  description String
  isDirty     Boolean? // Client-to-server synched
  revisions   RevisionNode[]

  path     String        @unique
  depth    Int           @default(0)
  numchild Int           @default(0)
  parent   RequestNode?  @relation("Self", fields: [parentId], references: [id], onDelete: Cascade)
  parentId Int?
  children RequestNode[] @relation("Self")

  request   Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId Int

  position Int // For demanding within a parent node

  isVariantsGroup Boolean // Contains a list of variant nodes requested by different users
  isNonNegotiable Boolean

  // alignedProposalFeedback FeedbackNode[] // Feeback ratings for the level of alignment with a proposal node(could be 'impact' instead of 'alignment')
  tags                  Tag[]
  assignedCognitiveBias AssignedCognitiveBias[]

  relatedProblems  RequestNode[] @relation("RelatedRequests")
  relatedSolutions RequestNode[] @relation("RelatedRequests") // Already resolved requests dealing with similar problems

  // requestedAt DateTime? @default(now())
  // deliveryAt  DateTime? // Urgency

  // conflictingInterests Request[]      @relation("ConflictOfInterest") // Can be auto-generated from the requestNodes tree
  feedback  Feedback[] // Auto-generated when adding feedback to proposed steps
  expertise ExpertiseNode? @relation(fields: [expertiseNodeId], references: [id]) // Required expertise for providing feedback

  owner           User   @relation("RequestNodeOwner", fields: [ownerId], references: [id])
  ownerId         String
  editors         User[] @relation("RequestNodeEditors")
  expertiseNodeId Int?

  @@index([path])
}

// A plan, proposal or offer aimed at satisfying a specific request 
// which can have both beneficial and detrimental impacts

// User-rated entity relating request nodes with proposals through
// impact-potential feedback, costs and side-effects.

model Proposal {
  id         Int      @id @default(autoincrement())
  modifiedAt DateTime @updatedAt
  createdAt  DateTime @default(now())
  isActive   Boolean  @default(true)

  title       String         @unique
  description String
  isDirty     Boolean? // Client-server-clients sync flag
  revisions   RevisionNode[]

  // Variants
  variantParent   Proposal?  @relation("Self", fields: [variantParentId], references: [id], onDelete: Cascade)
  variantParentId Int?
  variants        Proposal[] @relation("Self")

  request   Request @relation(fields: [requestId], references: [id])
  requestId Int

  isComplete Boolean // Is true upon completion of all children if any
  startsAt   DateTime?
  duration   Float // Proposal duration in days 
  priority   Int
  riskFactor Int

  approvedAt DateTime?

  netBenefit     Float @default(0)
  netFeasibility Float @default(0)

  isDraft       Boolean? // Not quite required if step costs update netFeasibility when added
  isUnavailable Boolean?

  requestNodeImpact     Feedback[] // Voted feedback from experts based on the related interests
  tags                  Tag[]
  steps                 Step[]
  assignedCognitiveBias AssignedCognitiveBias[]

  owner    User      @relation("ProposalOwner", fields: [ownerId], references: [id])
  ownerId  String
  editors  User[]    @relation("ProposalEditors")
  comments Comment[]
}

// An action task which is referenced by proposals in relatio to a request
// NB: The node fields are commented in this early version for the sake of simplicity
model Step {
  id         Int      @id @default(autoincrement())
  modifiedAt DateTime @updatedAt
  createdAt  DateTime @default(now())
  isActive   Boolean  @default(true)

  title       String         @unique
  description String
  isDirty     Boolean? // Client-server-clients sync flag
  revisions   RevisionNode[]

  // path     String     @unique
  // depth    Int        @default(0)
  // numchild Int        @default(0)
  // parent   Step?  @relation("Self", fields: [parentId], references: [id], onDelete: Cascade)
  // parentId Int?
  // children Step[] @relation("Self")

  position Int @default(0)

  duration         Float
  durationVariance Float
  riskFactor       Int

  proposal      Proposal   @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  proposalId    Int
  costs         StepCost[]
  effects       Effect[]
  AssignedUsers User[]
  tags          Tag[]

  owner      User      @relation("StepOwner", fields: [ownerId], references: [id])
  ownerId    String
  editors    User[]    @relation("StepEditors")
  resource   Resource? @relation(fields: [resourceId], references: [id])
  resourceId Int?

  @@unique([proposalId, position])
  @@index([proposalId, position])
}

// Resource quantity produced or consumed by a step node which can have multiple costs
// The quantity is substracted from the community stock when consumedAt is specified
model StepCost {
  id         Int      @id @default(autoincrement())
  modifiedAt DateTime @updatedAt
  createdAt  DateTime @default(now())
  isActive   Boolean  @default(true)

  title       String         @unique
  description String
  isDirty     Boolean? // Client-server-clients sync flag
  revisions   RevisionNode[]

  resourceCostPerUnitNode   ResourceCostPerUnitNode? @relation(fields: [resourceCostPerUnitNodeId], references: [id])
  resourceCostPerUnitNodeId Int?
  communityResource         CommunityResource        @relation(fields: [communityResourceId], references: [id])
  communityResourceId       Int

  step   Step? @relation(fields: [stepId], references: [id])
  stepId Int?

  measurementType MeasurementType
  quantity        Float // A negative value denotes a production output rather than a cost
  quantityMargin  Float
  monetaryValue   Float // Only used when the mentioned quantity is unavailable in the community stock
  consumedAt      DateTime
  // costVariationType Int // Linear, Exponential, Custom

  // resourceDemand ResourceDemand[]
  tags           Tag[]
  stockMovements StockMovement[]

  owner   User   @relation("StepCostOwner", fields: [ownerId], references: [id])
  ownerId String
  editors User[] @relation("StepCostEditors")

  // @@unique([stepId])
}

// Availability of a specific resource used or produced in 
// associated proposal steps
model Resource {
  id         Int      @id @default(autoincrement())
  modifiedAt DateTime @updatedAt
  createdAt  DateTime @default(now())
  isActive   Boolean  @default(true)

  title       String         @unique
  description String
  isDirty     Boolean? // Client-server-clients sync flag
  revisions   RevisionNode[]

  measurementType   MeasurementType
  quantityAvailable Float
  monthlyCapacity   Float // Amount that can be renewed within a month (includes volunteer time)
  // managedMonthlyCapacity Float
  minQuantity       Float
  reservedQuantity  Float
  shelfLife         Int? // In days

  transportWeightPerUnit Float?
  transportVolumePerUnit Float?

  // components ResourceCostPerUnitNode[] // "used as ingredient in these BOMs"

  // stepsPerAdditionalRenewalCapacity Step[] //
  tags           Tag[]
  localResources CommunityResource[]

  // tags  Tag[]
  owner   User   @relation("ResourceOwner", fields: [ownerId], references: [id])
  ownerId String
  editors User[] @relation("ResourceEditors")
  steps   Step[]

  resourceCostPerUnitNodes ResourceCostPerUnitNode[]
}

model CommunityResource {
  id         Int      @id @default(autoincrement())
  modifiedAt DateTime @updatedAt
  createdAt  DateTime @default(now())
  isActive   Boolean

  resource    Resource  @relation(fields: [resourceId], references: [id])
  resourceId  Int
  community   Community @relation(fields: [communityId], references: [id])
  communityId Int

  quantity             Float
  monthlyCapacity      Float // Amount that can be renewed within a month (includes volunteer time)
  // managedMonthlyCapacity Float
  minQuantity          Float
  reservedQuantity     Float
  monetaryValuePerUnit Float // Per specified unit

  // resourceDemand          ResourceDemand[]
  stepCosts      StepCost[]
  stockMovements StockMovement[]
}

// NB: The node fields are commented in this version for the sake of simplicity
model StockMovement {
  id         Int      @id @default(autoincrement())
  modifiedAt DateTime @updatedAt
  createdAt  DateTime @default(now())
  isActive   Boolean

  user                User              @relation(fields: [userId], references: [id])
  userId              String
  resource            CommunityResource @relation(fields: [communityResourceId], references: [id])
  communityResourceId Int
  stepCost            StepCost?         @relation(fields: [stepCostId], references: [id])
  stepCostId          Int?

  quantity       Float
  quantityBefore Float
  quantityAfter  Float
  reason         String?
}

