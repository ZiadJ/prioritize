model TravelCost {
  id         Int      @id @default(autoincrement())
  modifiedAt DateTime @updatedAt
  createdAt  DateTime @default(now())
  isActive   Boolean  @default(true)

  origin        Community @relation("TravelCostOrigin", fields: [originId], references: [id])
  originId      Int
  destination   Community @relation("TravelCostDestination", fields: [destinationId], references: [id])
  destinationId Int

  // Actual cost = max(quantity_kg * costPerKg, volume_m3 * costPerM3)
  costPerKg Float?
  costPerM3 Float?
  duration  Int // Travel duration in days (required for delivery date)
}

model ResourceCostPerUnitNode {
  id         Int      @id @default(autoincrement())
  modifiedAt DateTime @updatedAt
  createdAt  DateTime @default(now())
  isActive   Boolean  @default(true)

  //revisions RevisionNode[]
  // Tree structure — each node is one ingredient in its parent's composition
  path     String                    @unique
  depth    Int                       @default(0)
  numchild Int                       @default(0)
  parent   ResourceCostPerUnitNode?  @relation("Self", fields: [parentId], references: [id], onDelete: Cascade)
  parentId Int?
  children ResourceCostPerUnitNode[] @relation("Self")

  // What resource this component node represents (the ingredient) (e.g. "Glass", "Sand", "Fuel")
  Resource   Resource? @relation(fields: [ResourceId], references: [id])
  ResourceId Int?

  // How much of this resource is required to produce one unit of the parent
  quantityPerParentUnit Float @default(1)
  // quantityMargin        Float @default(0)
  // unit           String     @default("unit") // "g", "kg", "hr", "L", etc.

  stepCosts StepCost[]

  // owner   User   @relation("ResourceComponentOwner", fields: [ownerId], references: [id])
  // ownerId String
  // editors User[] @relation("ResourceComponentEditors")
  @@index([path])
}

// A impacting side-effect when a request node is enacted upon

model Effect {
  id         Int      @id @default(autoincrement())
  modifiedAt DateTime @updatedAt
  createdAt  DateTime @default(now())
  isActive   Boolean  @default(true)

  title       String         @unique
  description String
  isDirty     Boolean? // Client-server-clients sync flag
  revisions   RevisionNode[]

  request   Request? @relation(fields: [requestId], references: [id])
  requestId Int?

  isOpportunistic Boolean // Side-effect is beneficial
  delay           Int
  duration        Int
  relationType    RelationType
  relationFormula String

  steps    Step[]
  feedback Feedback[]
  tags     Tag[]

  effectorFrom Effector[]      @relation("from")
  effectorTo   Effector[]      @relation("to")
  expertise    ExpertiseNode[]
}

// A uni-directional linkage between two effects

model Effector {
  id         Int      @id @default(autoincrement())
  modifiedAt DateTime @updatedAt
  createdAt  DateTime @default(now())
  isActive   Boolean  @default(true)

  title       String         @unique
  description String
  isDirty     Boolean? // Client-server-clients sync flag
  revisions   RevisionNode[]

  from   Effect @relation("from", fields: [fromId], references: [id], onDelete: Cascade)
  fromId Int
  to     Effect @relation("to", fields: [toId], references: [id], onDelete: Cascade)
  toId   Int

  strength Int

  @@unique([fromId, toId])
}

// A community organization with hierarchical structure and location data

model Community {
  id         Int      @id @default(autoincrement())
  modifiedAt DateTime @updatedAt
  createdAt  DateTime @default(now())
  isActive   Boolean  @default(true)

  title       String @unique
  description String

  // path     String          @unique
  // depth    Int             @default(0)
  // numchild Int             @default(0)
  // parent   Community?  @relation("Self", fields: [parentId], references: [id], onDelete: Cascade)
  // parentId Int?
  // children Community[] @relation("Self")

  country   Country? @relation(fields: [countryId], references: [id])
  countryId Int?

  address   String
  longitude Float
  latitude  Float
  location  Unsupported("geography(Point, 4326)")?

  requests                Request[]
  members                 User[]
  regionalCommunities     Community[]         @relation("RegionalCommunities")
  regionalCommunityOf     Community[]         @relation("RegionalCommunities")
  localCommunities        Community[]         @relation("localCommunities")
  localCommunityOf        Community[]         @relation("localCommunities")
  communityResources      CommunityResource[]
  travelCostOrigins       TravelCost[]        @relation("TravelCostOrigin")
  travelCostsDestinations TravelCost[]        @relation("TravelCostDestination")

  // @@index([path])
}

model Country {
  id         Int      @id @default(autoincrement())
  modifiedAt DateTime @updatedAt
  createdAt  DateTime @default(now())
  isActive   Boolean  @default(true)
  name       String   @unique
  code       String   @unique
  phoneCode  String?

  communities Community[]
  users       User[]
  requests    Request[]

  @@index([name])
  @@index([code])
}

model Comment {
  id         Int      @id @default(autoincrement())
  modifiedAt DateTime @updatedAt
  createdAt  DateTime @default(now())
  isActive   Boolean  @default(true)

  content   String
  isDirty   Boolean? // Client-server-clients sync flag
  revisions RevisionNode[]

  path     String    @unique
  depth    Int       @default(0)
  numchild Int       @default(0)
  parent   Comment?  @relation("Self", fields: [parentId], references: [id], onDelete: Cascade)
  parentId Int?
  children Comment[] @relation("Self")

  proposal   Proposal? @relation(fields: [proposalId], references: [id])
  proposalId Int?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  //step Step? @relation(fields: [stepId], references: [id])
  //stepId Int?
}
